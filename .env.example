# ============================================================
# ScribeFlow AI — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual API keys.
#   cp .env.example .env
# ============================================================

# ── Required ─────────────────────────────────────────────────
# Mistral API key (get one at https://console.mistral.ai/)
MISTRAL_API_KEY=your_mistral_api_key_here

# ── Required only for Hinglish transcription ─────────────────
# Sarvam AI key (get one at https://dashboard.sarvam.ai/)
SARVAM_API_KEY=your_sarvam_api_key_here

# ── Optional — Whisper model size ────────────────────────────
# Options: tiny, base, small (default), medium, large
# Larger models are more accurate but slower and use more RAM.
WHISPER_MODEL=small

# ── Optional — Sarvam STT model ──────────────────────────────
SARVAM_STT_MODEL=saaras:v2.5
